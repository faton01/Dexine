# Public URL of the site (used for SEO metadata, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
# Without this key, checkout is disabled and the cart says so (nothing is faked).
STRIPE_SECRET_KEY=

# Newsletter — Buttondown (https://buttondown.com) API key.
# Without it the signup form reports that subscriptions are not yet open.
BUTTONDOWN_API_KEY=

# Instagram — optional live feed (Instagram API with Instagram Login, long-lived token).
# Without it the homepage shows a link to the profile instead of a feed.
INSTAGRAM_ACCESS_TOKEN=
